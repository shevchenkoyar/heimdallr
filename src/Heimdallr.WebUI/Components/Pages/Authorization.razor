@attribute [Route(PageRoute.AuthPage)]
@using Heimdallr.WebUI.Common.Constants
@using Heimdallr.WebUI.Components.Common.Button
@using Heimdallr.WebUI.Components.Common.Input

@layout AuthorizationLayout
@rendermode InteractiveServer

<div class="bg-gray-800 border border-primary mx-auto px-3 py-5 w-175">
    <div class="flex flex-col p-5 gap-3">
        <div class="flex flex-col gap-1">
            <h2 class="text-2xl">Авторизаций</h2>
        </div>
        <div class="flex flex-col gap-1">
            <label for="@ElementIds.AuthLoginId">Имя пользователя</label>
            <input id="@ElementIds.AuthLoginId" class="border border-primary px-3 py-2" type="text" @bind="Login"/>
        </div>
        <div class="flex flex-col gap-1">
            <Password @bind-Value="Password"/>
        </div>
        <div class="flex">
            <TextButton Text="Войти" Id="button-login" OnClick="@Submit"/>
        </div>
    </div>
</div>