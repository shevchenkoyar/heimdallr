@using Heimdallr.WebUI.Common.Constants
@using Heimdallr.WebUI.Components.Common.Button

@rendermode InteractiveServer

<label for="@ElementIds.AuthPasswordId">Пароль</label>
<div class="flex flex-row gap-0">
    <input id="@ElementIds.AuthPasswordId" class="border border-primary px-3 py-2 flex-1"
           type="@PasswordInputType.ToString().ToLower()"
           @bind="@Value"
           @bind:event="oninput"/>
    <TextButton Text="👀" OnClick="@ShowPassword" />
</div>