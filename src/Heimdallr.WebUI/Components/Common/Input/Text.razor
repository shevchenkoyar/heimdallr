<input id="@Id" class="border border-primary px-3 py-2" type="text" value="@Value" @onchange="OnChange"/>

@code {
    [Parameter] public string Id { get; set; } = "input-" + Guid.NewGuid().ToString("N");

    [Parameter, EditorRequired] public required string Value { get; set; }

    [Parameter] public string Placeholder { get; set; } = "";

    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback ValueChangedAfter { get; set; }

    private async Task OnChange(ChangeEventArgs args)
    {
        await ValueChanged.InvokeAsync(args.Value?.ToString());
        await ValueChangedAfter.InvokeAsync();
    }
}