<button class="bg-primary @TextColor px-3 py-1 hover:cursor-pointer @Class" type="button" 
        @onclick="OnClickHandler">
    @Text
</button>

@code{
    [Parameter, EditorRequired] public required string Text { get; set; }
    
    [Parameter, EditorRequired] public string Id { get; set; } = "button-" + Guid.NewGuid().ToString("N");

    [Parameter] public EventCallback OnClick { get; set; }
    
    [Parameter] public EventCallback OnClickAfter { get; set; }
    
    [Parameter] public string Class { get; set; } = "";

    [Parameter] public string TextColor { get; set; } = "text-gray-900";
    
    private async Task OnClickHandler()
    {
        await OnClick.InvokeAsync();
        await OnClickAfter.InvokeAsync();
    }
}